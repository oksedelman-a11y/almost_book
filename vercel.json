{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "cd artifacts/api-server && node ./build.mjs && cd ../story-blog && npx vite build --config vite.config.ts",
  "outputDirectory": "artifacts/story-blog/dist/public",
  "framework": null,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api-server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}