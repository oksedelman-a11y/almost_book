{
  "version": 2,
  "buildCommand": "cd artifacts/story-blog && npx vite build --config vite.config.ts",
  "outputDirectory": "artifacts/story-blog/dist/public",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api-server.js"
    }
  ]
}