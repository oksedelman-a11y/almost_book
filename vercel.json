{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "cd artifacts/api-server && node ./build.mjs && cd ../story-blog && PORT=3000 BASE_PATH=/ npx vite build --config vite.config.ts",
  "outputDirectory": "artifacts/story-blog/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "artifacts/api-server/dist/index.mjs": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/artifacts/api-server/dist/index.mjs" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}